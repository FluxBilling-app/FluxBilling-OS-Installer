# FluxBilling: automated-install hook for the Proxmox VE installer.
# Injected by the boot menu into the installer initrd as /etc/bash.bashrc
# (cpio append - later entries replace the vendor file).
#
# WHY A BASHRC, OF ALL THINGS. A stock Proxmox ISO has no answer-file boot
# argument: unconfigured.sh (the installer's PID 1) only runs
# proxmox-fetch-answer when /cdrom/auto-installer-mode.toml exists, and only
# `proxmox-auto-install-assistant prepare-iso` can create that file - INSIDE
# the ISO, which this menu deliberately fetches unmodified. When the mode
# file is missing but proxmox-start-auto-installer is on the command line,
# the stock fallback is an interactive debug shell that says, verbatim:
#
#   "to fetch the answer file manually use:
#      proxmox-fetch-answer MODE >/run/automatic-installer-answers"
#
# and after that shell exits, unconfigured.sh pipes
# /run/automatic-installer-answers into proxmox-auto-installer REGARDLESS of
# how it got there. That debug shell is interactive bash; interactive bash
# sources /etc/bash.bashrc; so this file is that documented manual step,
# automated. Fragile by nature - but it fails SAFE: if a future installer
# restructures the flow, the operator lands in the stock debug shell with
# the stock instructions on screen, not in a half-configured install.
#
# The answers are generated here, at install time, instead of shipping a
# static answer.toml, for the same reason ks.cfg has a %pre: the hostname,
# network and password are typed into the menu at boot, and the target disk
# and NIC can only be identified on the machine itself.

flux_pve_auto() {
    # Every guard must hold, in this order, before touching anything:
    #  - the Proxmox auto-installer exists (this file rides along unread in
    #    any other family's initrd that happens to run interactive bash,
    #    e.g. a dracut emergency shell);
    #  - the menu armed automated mode for a pve entry (fluxpveauto=1 is set
    #    next to proxmox-start-auto-installer in :os_pick, automated only);
    #  - this is not the tty3 convenience root shell unconfigured.sh spawns
    #    in parallel - killing that would cost the operator a live console
    #    for no gain, and if /etc/profile happens to chain into this file,
    #    exiting it could fire BEFORE the gate shell and deadlock the flow;
    #  - no answers exist yet. This is what separates the gate's debug shell
    #    (spawned precisely because answers are missing - generate and exit)
    #    from a post-error debug shell (spawned after an install attempt
    #    consumed the answers - stay interactive so the error can be read).
    [ -x /usr/bin/proxmox-auto-installer ] || return 0
    grep -qw 'fluxpveauto=1' /proc/cmdline 2>/dev/null || return 0
    case "$(tty 2>/dev/null)" in */tty3) return 0 ;; esac
    local ans=/run/automatic-installer-answers
    [ -s "$ans" ] && return 0

    echo "FLUX: generating automated-install answers from the kernel command line"

    local c zget h fqdn p plen ipc ip gw ns mac hash disk
    c=$(cat /proc/cmdline)
    zget() { printf '%s\n' "$c" | tr ' ' '\n' | sed -n "s/^$1=//p" | head -n1; }

    # Hostname: sanitised to what both DNS and TOML can carry - the value
    # lands inside a quoted TOML string, so shell metacharacters are inert
    # but a stray quote would truncate it. The installer insists on an FQDN;
    # bare names get the same domain preseed.cfg hands to d-i.
    h=$(zget fluxhost | tr -cd 'A-Za-z0-9.-'); [ -n "$h" ] || h=fluxserver
    case "$h" in *.*) fqdn=$h ;; *) fqdn=$h.fluxbilling.app ;; esac

    plen=$(zget fluxcidr); [ -n "$plen" ] || plen=24
    # ip=ADDR::GW:NM:HOST::none:NS1:NS2 - same string every family parses.
    # Field 7 is the autoconf mode ("none"), the first nameserver is field 8.
    ipc=$(zget ip)
    ip=$(printf '%s' "$ipc" | cut -d: -f1)
    gw=$(printf '%s' "$ipc" | cut -d: -f3)
    ns=$(printf '%s' "$ipc" | cut -d: -f8); [ -n "$ns" ] || ns=8.8.8.8
    # BOOTIF=01-aa-bb-cc-dd-ee-ff selects the boot NIC by MAC, matching the
    # udev ID_NET_NAME_MAC property (enx<mac>) by suffix wildcard below.
    mac=$(zget BOOTIF | sed 's/^01-//; s/-//g')

    # The password never goes into the answers in cleartext: the answer file
    # outlives this environment if the installer archives it with its logs,
    # and there is no post-install hook on this family to scrub it (the
    # [first-boot] section only works from a prepared ISO or a URL). A
    # SHA-512 crypt hash is what /etc/shadow would hold anyway. perl is a
    # hard dependency of the installer itself (proxinstall is perl), and the
    # password reaches it through the ENVIRONMENT - never argv, which any
    # process could read from /proc while this runs. No fallback password:
    # an empty fluxpass= yields "!", i.e. root ships LOCKED, like every
    # other family in this image.
    p=$(zget fluxpass)
    if [ -n "$p" ]; then
        hash=$(FLUXP="$p" perl -e '
            my @c = ("a".."z", "A".."Z", "0".."9", ".", "/");
            my $s = join "", map { $c[rand @c] } 1..16;
            print crypt($ENV{FLUXP}, "\$6\$$s\$");') || hash=
        # glibc's crypt returns a $6$...$... string for a $6$ salt. A libc
        # without SHA-512 support instead treats "$6" as a DES salt and
        # returns a 13-character DES hash of the FIRST 8 password bytes -
        # silently, which would ship a weaker hash than the operator typed a
        # password for. Refuse anything that is not the algorithm asked for.
        case $hash in
        '$6$'*) ;;
        *)
            echo "FLUX: crypt() did not produce a SHA-512 hash - leaving the stock debug shell in charge" >&2
            unset -v p; unset -f zget
            return 0
            ;;
        esac
    else
        echo "FLUX: no fluxpass= on the kernel command line - root ships LOCKED." >&2
        hash='!'
    fi
    unset -v p

    # The install disk, by the rule every automated entry shares - and, when
    # the operator answered Yes on the menu's erase-all-disks screen
    # (fluxwipe=1 on the command line), every disk wiped first, so an old
    # install's ZFS pool or LVM volume group can never be found again on a
    # disk this install left alone. VERBATIM copy of src/flux-disks, held to
    # it by src/disks-test.sh: this file is baked into the release initrd by
    # sign-boot-images.sh, and nothing the menu appends survives that far.
    # Fail CLOSED - a nonexistent name makes the installer stop with an error
    # instead of picking whatever disk it fancies.
    cat > /tmp/flux-disks <<'FLUXEOF'
#!/bin/sh
# FluxBilling: pick the install disk, and wipe every disk when told to.
#
# One rule shared by every automated entry in the menu, so d-i, subiquity,
# anaconda, AutoYaST, Agama and the Proxmox installer all put the operating
# system on the same disk of the same server:
#
#   TARGET  the first ELIGIBLE disk in kernel-name order - the order
#           /sys/block/* sorts in, which is also the order d-i's own
#           list-devices walks: nvme0n1 before sda, sda before sdb.
#   WIPE    with fluxwipe=1 on the kernel command line, EVERY eligible disk
#           is wiped before the installer looks at any of them - the target
#           and all the others. The boot menu adds fluxwipe=1 only after the
#           operator answers "Yes" on its erase-all-disks screen. Without it
#           (manual mode, or an older menu booting a newer boot image) this
#           still picks the target and wipes nothing.
#
# Prints the target as /dev/<name> on stdout and exits 0. Exits 1 with nothing
# on stdout - and nothing wiped - when no disk qualifies; every caller turns
# that into a stopped install rather than a guess. Messages go to stderr and
# the kernel log, never stdout, because callers capture stdout.
#
# ELIGIBLE is a local, writable whole disk that is not removable media:
#   - not a virtual or stacked device (loop, ram, zram, dm, md, sr, fd, nbd,
#     drbd, zvol, rbd, pmem, mtd, ubi, bcache, eMMC boot areas);
#   - removable=0: USB sticks, card readers and BMC virtual media report 1,
#     and this image is booted from exactly those;
#   - not attached over USB at all - some sticks report removable=0, and the
#     stick this installer booted from must never be chosen or wiped;
#   - not a Fibre Channel or iSCSI LUN - shared SAN storage belongs to
#     whoever else is zoned to it;
#   - writable (ro=0), not empty, and not a hidden NVMe multipath path.
#
# The WIPE is quick on purpose - an automated install has to stay one. Per
# disk: whatever lives on it is stopped first (swap, mounts, md arrays, LVM,
# dm-crypt); then the first and last 16 MiB of every partition and of the
# whole disk are zeroed, which takes out the partition tables (MBR and both
# GPT copies), RAID metadata at either end (md 0.90/1.x, DDF, Intel IMSM),
# LVM, ZFS labels, LUKS headers and keyslots, and filesystem superblocks;
# last, the whole device is discarded where it supports it, which on SSD and
# NVMe drops the data itself. Sectors in the middle of a spinning disk are NOT
# overwritten: that takes hours per disk and is a job for a dedicated erase,
# not for an installer.
#
# A disk that is still in use after all that - something the installer
# environment itself depends on - is skipped and named in the log rather than
# pulled out from under a running system.
#
# Plain POSIX sh plus cat/dd/sed/grep/readlink, because it runs under d-i's
# busybox (no awk there) as well as dash and bash. mdadm, dmsetup, wipefs,
# blkdiscard, python3, blockdev and udevadm are used when present and skipped
# when not - anaconda's stage2, for one, has no blkdiscard, so python3 issues
# the same ioctl there. The flux_* variables exist so src/disks-test.sh can
# aim all of this at a fake /sys and /dev; in an installer they are unset.

export LC_ALL=C
S=${flux_sys:-/sys}
D=${flux_dev:-/dev}
P=${flux_proc:-/proc}
# 16 MiB, in the 512-byte sectors /sys/block reports sizes and offsets in.
EDGE=32768

say() {
	echo "FluxBilling: $*" >&2
	echo "<5>FluxBilling: $*" >> "${flux_kmsg:-/dev/kmsg}" 2>/dev/null || :
}

# /dev node for a /sys/block name - sysfs spells nested nodes with '!'
# (/sys/block/cciss!c0d0 is /dev/cciss/c0d0).
node() {
	echo "$D/$(echo "$1" | sed 's,!,/,g')"
}

eligible() { # eligible <name>
	local b=$S/block/$1 n
	case $1 in
	loop*|ram*|zram*|dm-*|md*|sr*|fd*|nbd*|drbd*|zd*|rbd*|pmem*|mtd*|ubi*|bcache*)
		return 1 ;;
	mmcblk*boot*|mmcblk*rpmb|nvme*c*)
		return 1 ;;
	esac
	[ "$(cat "$b/removable" 2>/dev/null)" = 0 ] || return 1
	[ "$(cat "$b/ro" 2>/dev/null)" = 0 ] || return 1
	[ "$(cat "$b/hidden" 2>/dev/null || echo 0)" = 0 ] || return 1
	n=$(cat "$b/size" 2>/dev/null)
	[ "${n:-0}" -gt 0 ] 2>/dev/null || return 1
	# The device path names the bus: .../usb2/2-1/... for USB (UAS included),
	# .../rport-2:0-0/... for Fibre Channel, .../session3/... for iSCSI.
	case $(readlink -f "$b" 2>/dev/null) in
	*/usb[0-9]*|*/rport-*|*/session[0-9]*)
		return 1 ;;
	esac
	return 0
}

describe() { # describe <name> - "/dev/sda (447 GiB INTEL SSDSC2KB48)"
	local b=$S/block/$1 n m
	n=$(cat "$b/size" 2>/dev/null)
	m=$(cat "$b/device/model" 2>/dev/null | sed 's/[[:space:]]*$//')
	echo "$(node "$1") ($(( ${n:-0} / 2097152 )) GiB${m:+ $m})"
}

# under <sysfs dir> - the whole disk(s) a block device ultimately sits on:
# a partition belongs to its parent disk, md and device-mapper devices to
# whatever their slaves sit on.
under() {
	local d s found=
	d=$(readlink -f "$1" 2>/dev/null) || return 0
	if [ -e "$d/partition" ]; then
		d=$(readlink -f "$d/.." 2>/dev/null)
		echo "${d##*/}"
		return 0
	fi
	for s in "$d"/slaves/*; do
		[ -e "$s" ] || continue
		found=1
		under "$s"
	done
	[ -n "$found" ] || echo "${d##*/}"
}

# on_wiped <device> <disk>... - succeed if the device lives on one of them.
on_wiped() {
	local r u w
	r=$(readlink -f "$1" 2>/dev/null) || return 1
	r=$S/class/block/${r##*/}
	[ -e "$r" ] || return 1
	shift
	for u in $(under "$r"); do
		for w in "$@"; do
			[ "$u" = "$w" ] && return 0
		done
	done
	return 1
}

# unuse <disk>... - swapoff and unmount whatever lives on these disks. casper
# swaps on every swap partition it finds on a local disk (its 13swap hook), so
# on a reinstall the old system's swap is typically live in the installer.
# Mounts go newest first, so a nested mount is released before its parent.
unuse() {
	local dev rest
	while read -r dev rest; do
		case $dev in /*) ;; *) continue ;; esac
		on_wiped "$dev" "$@" || continue
		say "releasing swap on $dev"
		swapoff "$dev" 2>/dev/null || :
	done < "$P/swaps"
	sed '1!G;h;$!d' "$P/mounts" | while read -r dev rest; do
		case $dev in /*) ;; *) continue ;; esac
		on_wiped "$dev" "$@" || continue
		say "unmounting $dev"
		umount "$dev" 2>/dev/null || :
	done
}

# release <sysfs dir> - stop md arrays and device-mapper devices (LVM,
# dm-crypt, multipath) stacked on a disk or partition, deepest first.
release() {
	local h n
	for h in "$1"/holders/*; do
		[ -e "$h" ] || continue
		n=${h##*/}
		release "$S/block/$n"
		case $n in
		md*)
			command -v mdadm >/dev/null 2>&1 &&
				mdadm --stop "$(node "$n")" >/dev/null 2>&1 ;;
		dm-*)
			command -v dmsetup >/dev/null 2>&1 &&
				dmsetup remove "$(cat "$S/block/$n/dm/name" 2>/dev/null)" >/dev/null 2>&1 ;;
		esac
	done
}

# parts <name> - the partition directories of a disk.
parts() {
	local p
	for p in "$S/block/$1/$1"*; do
		[ -e "$p/partition" ] && echo "$p"
	done
}

# busy <name> - succeed if anything still holds the disk or a partition.
busy() {
	local p h
	for p in "$S/block/$1" $(parts "$1"); do
		for h in "$p"/holders/*; do
			[ -e "$h" ] && return 0
		done
		grep -q "^$D/${p##*/}[[:space:]]" "$P/swaps" "$P/mounts" 2>/dev/null && return 0
	done
	return 1
}

# zero <node> <first sector> <sectors>
zero() {
	if [ $(($2 % 2048)) -eq 0 ] && [ $(($3 % 2048)) -eq 0 ]; then
		dd if=/dev/zero of="$1" bs=1048576 seek=$(($2 / 2048)) count=$(($3 / 2048)) conv=notrunc 2>/dev/null
	else
		dd if=/dev/zero of="$1" bs=512 seek="$2" count="$3" conv=notrunc 2>/dev/null
	fi
}

# edges <node> <first sector> <sectors> - zero both ends of a range, or all
# of it when it is too small to have two separate ends.
edges() {
	if [ "$3" -le $((EDGE * 2)) ]; then
		zero "$1" "$2" "$3"
	else
		zero "$1" "$2" "$EDGE" && zero "$1" $(($2 + $3 - EDGE)) "$EDGE"
	fi
}

wipe() { # wipe <name>
	local b=$S/block/$1 dev size p ok=1 how
	dev=$(node "$1")
	size=$(cat "$b/size")
	for p in $(parts "$1"); do
		edges "$dev" "$(cat "$p/start")" "$(cat "$p/size")" || ok=
	done
	edges "$dev" 0 "$size" || ok=
	# Belt and braces: anything libblkid still recognises after the zeroing.
	command -v wipefs >/dev/null 2>&1 && wipefs -a "$dev" >/dev/null 2>&1
	how="signatures and partition tables zeroed"
	if [ "$(cat "$b/queue/discard_max_bytes" 2>/dev/null || echo 0)" = 0 ]; then
		how="$how; no discard support, so the rest of the disk is not overwritten"
	# stdin from /dev/null: util-linux blkdiscard asks for -f only when it is
	# talking to a terminal, and some installer shells are one.
	elif command -v blkdiscard >/dev/null 2>&1 &&
			blkdiscard "$dev" </dev/null >/dev/null 2>&1; then
		how="$how, whole device discarded"
	elif command -v python3 >/dev/null 2>&1 &&
			python3 -c 'import fcntl, os, struct, sys
fd = os.open(sys.argv[1], os.O_WRONLY)
fcntl.ioctl(fd, 0x1277, struct.pack("QQ", 0, int(sys.argv[2]) * 512))' "$dev" "$size" >/dev/null 2>&1; then
		how="$how, whole device discarded"
	elif command -v blkdiscard >/dev/null 2>&1 || command -v python3 >/dev/null 2>&1; then
		how="$how; discard FAILED, so the rest of the disk is not overwritten"
	else
		how="$how; no discard tool in this installer, so the rest of the disk is not overwritten"
	fi
	if [ -n "$ok" ]; then
		say "wiped $(describe "$1"): $how"
	else
		say "WIPE INCOMPLETE on $(describe "$1"): a write failed"
	fi
}

wanted() {
	grep -qw 'fluxwipe=1' "${flux_cmdline:-$P/cmdline}" 2>/dev/null
}

command -v udevadm >/dev/null 2>&1 && udevadm settle --timeout=60 >/dev/null 2>&1

set --
for b in "$S"/block/*; do
	[ -e "$b" ] || continue
	eligible "${b##*/}" && set -- "$@" "${b##*/}"
done

if [ $# -eq 0 ]; then
	say "no eligible install disk found - nothing chosen, nothing wiped"
	exit 1
fi

say "install disk: $(describe "$1")"

if wanted; then
	say "fluxwipe=1: wiping every eligible disk before the install: $*"
	unuse "$@"
	for n in "$@"; do
		for p in "$S/block/$n" $(parts "$n"); do
			release "$p"
		done
	done
	for n in "$@"; do
		if busy "$n"; then
			say "$(describe "$n") is still in use - NOT wiped"
			continue
		fi
		wipe "$n" &
	done
	wait
	sync
	for n in "$@"; do
		command -v blockdev >/dev/null 2>&1 && blockdev --rereadpt "$(node "$n")" >/dev/null 2>&1
	done
	command -v udevadm >/dev/null 2>&1 && udevadm settle --timeout=60 >/dev/null 2>&1
else
	say "no fluxwipe=1 on the kernel command line - no disk is wiped"
fi

node "$1"
FLUXEOF
    disk=$(sh /tmp/flux-disks) || disk=flux-no-fixed-disk-found
    disk=${disk#/dev/}

    # kebab-case keys: accepted since PVE 8.4, the only spelling not
    # deprecated in 9.x - both ISOs this menu boots qualify. Keyboard,
    # country and timezone mirror the other answer files in this repo.
    cat > "$ans" <<EOF
[global]
keyboard = "en-us"
country = "ro"
fqdn = "$fqdn"
mailto = "root@localhost"
timezone = "Europe/Bucharest"
root-password-hashed = "$hash"
reboot-on-error = false

[network]
source = "from-answer"
cidr = "$ip/$plen"
gateway = "$gw"
dns = "$ns"
filter.ID_NET_NAME_MAC = "*$mac"

[disk-setup]
filesystem = "ext4"
disk-list = ["$disk"]
EOF
    chmod 600 "$ans"
    echo "FLUX: answers written for $fqdn ($ip/$plen on *$mac, disk $disk) - resuming automated install"
    # Exiting this shell returns control to unconfigured.sh, which feeds the
    # file just written to proxmox-auto-installer.
    exit 0
}
flux_pve_auto
unset -f flux_pve_auto
