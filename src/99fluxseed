#! /bin/sh
# FluxBilling: generate cloud-init NoCloud seed for subiquity autoinstall
# from kernel cmdline (fluxhost= fluxpass= fluxcidr= ip= BOOTIF=).
# Injected into the official casper initrd by build.sh; runs as a
# casper-bottom hook with the live root mounted at /root.

PREREQ=""
DESCRIPTION="FluxBilling: generating autoinstall seed..."

prereqs()
{
       echo "$PREREQ"
}

case $1 in
# get pre-requisites
prereqs)
       prereqs
       exit 0
       ;;
esac

. /scripts/casper-functions

log_begin_msg "$DESCRIPTION"

C=$(cat /proc/cmdline)

# MANUAL mode: the menu drops the `autoinstall` keyword. Bail out WITHOUT
# writing the NoCloud seed - subiquity treats any autoinstall: key in
# cloud-init user-data as "go ahead and install" even without the kernel
# arg, which would silently wipe the disk on a manual install.
if ! echo "$C" | tr ' ' '\n' | grep -qx autoinstall; then
    log_end_msg
    exit 0
fi

zget() {
    echo "$C" | tr ' ' '\n' | sed -n "s/^$1=//p" | head -n1
}

H=$(zget fluxhost)
[ -n "$H" ] || H=fluxserver
# fluxpass is deliberately NOT read here. subiquity archives the autoinstall
# user-data verbatim to /var/log/installer/autoinstall-user-data on the
# INSTALLED system, so any password interpolated into the template below is
# plaintext at rest forever. The late-commands read it from /proc/cmdline at
# run time instead, and there is no fallback: no fluxpass= means the accounts
# stay locked rather than getting a default published in a public repo.
CIDR=$(zget fluxcidr)
IPCFG=$(zget ip)
IP=$(echo "$IPCFG" | cut -d: -f1)
GW=$(echo "$IPCFG" | cut -d: -f3)
MAC=$(zget BOOTIF | sed 's/^01-//' | tr - :)

# escape for sed replacement
HS=$(echo "$H" | sed 's/[\/&]/\\&/g')

D=/root/var/lib/cloud/seed/nocloud
mkdir -p "$D"

cat > "$D/meta-data" <<EOF
instance-id: fluxbilling-$H
local-hostname: $H
EOF

# template: no shell expansion (quoted heredoc), placeholders swapped after
cat > "$D/user-data" <<'ZEOF'
#cloud-config
autoinstall:
  version: 1
  refresh-installer:
    update: no
  apt:
    disable_suites: [security]
    primary:
      - arches: [default]
        uri: http://archive.ubuntu.com/ubuntu/
  ssh:
    install-server: true
    allow-pw: true
  storage:
    layout:
      name: direct
    swap:
      size: 0
  packages:
    - openssh-server
  user-data:
    package_update: false
    package_upgrade: false
    # subiquity copies its logs AND this autoinstall config verbatim into
    # /var/log/installer on the installed system at the very end of the run -
    # after every late-command - and those logs record the kernel command
    # line, fluxpass= included. First boot is the first moment anything can
    # reach them, which is exactly when this cloud-init runcmd fires.
    write_files:
      - path: /usr/local/sbin/flux-scrub
        permissions: '0700'
        content: |
          #!/bin/sh
          find /var/log/installer -type f 2>/dev/null | while read -r f; do
              sed -i 's/fluxpass=[^[:space:]]*/fluxpass=<redacted>/g' "$f" 2>/dev/null || :
          done
          rm -f /usr/local/sbin/flux-scrub
    runcmd:
      - [ /usr/local/sbin/flux-scrub ]
  interactive-sections: []
  identity:
    hostname: '@ZH@'
    username: user
    # "!" = locked. subiquity needs the field, but this file is archived onto
    # the installed disk, so it must never carry a usable hash. The real
    # credentials are set from /proc/cmdline in the late-commands below.
    password: "!"
  late-commands:
    - |
      curtin in-target --target=/target -- bash -c 'P=$(tr " " "\n" < /proc/cmdline | sed -n "s/^fluxpass=//p" | head -n1); if [ -n "$P" ]; then printf "root:%s\nuser:%s\n" "$P" "$P" | chpasswd; else echo "FLUX: no fluxpass= on the kernel command line - root and user stay LOCKED." >&2; fi'
    - |
      curtin in-target --target=/target -- sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config
    - |
      curtin in-target --target=/target -- sed -i 's/GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"/GRUB_CMDLINE_LINUX_DEFAULT="quiet splash net.ifnames=0 biosdevname=0"/' /etc/default/grub
    - |
      curtin in-target --target=/target -- update-grub
    - |
      curtin in-target --target=/target -- bash -c 'echo "deb http://security.ubuntu.com/ubuntu $(lsb_release -cs)-security main restricted universe multiverse" >> /etc/apt/sources.list'
ZEOF

sed -i "s/@ZH@/$HS/g" "$D/user-data"

# static network for the installed system, matched by boot NIC MAC
if [ -n "$IP" ] && [ -n "$CIDR" ] && [ -n "$GW" ] && [ -n "$MAC" ]; then
cat >> "$D/user-data" <<ZEOF
  network:
    version: 2
    ethernets:
      fluxnic:
        match:
          macaddress: "$MAC"
        addresses: [ $IP/$CIDR ]
        routes:
          - to: default
            via: $GW
        nameservers:
          addresses: [8.8.8.8, 1.1.1.1]
ZEOF
fi

log_end_msg
