+/* FluxBilling: buffered key fetched by efi_iskey(), if any */
+static EFI_KEY_DATA efi_last_key;
+static int efi_have_key;
+
+/**
+ * Read a key from the EFI console input protocols
+ *
+ * FluxBilling: HP iLO4 (Gen8/Gen9) UEFI firmware exposes SimpleTextInputEx
+ * but keeps its keystroke queue and WaitForKeyEx event separate from the
+ * plain SimpleTextInput protocol - and stock iPXE reads through the Ex
+ * protocol while testing readiness on the PLAIN protocol's WaitForKey event
+ * (which the firmware then never signals), so every keystroke from the iLO
+ * virtual keyboard is dropped and the menu is undrivable except over SOL.
+ * Read through the Ex protocol when present and FALL BACK to the plain one,
+ * which also covers firmware whose ReadKeyStrokeEx is simply broken.
+ */
+static int efi_read_key ( EFI_KEY_DATA *key ) {
+	EFI_SIMPLE_TEXT_INPUT_PROTOCOL *conin = efi_systab->ConIn;
+	EFI_SIMPLE_TEXT_INPUT_EX_PROTOCOL *conin_ex = efi_conin_ex;
+	EFI_STATUS efirc;
+
+	if ( conin_ex ) {
+		memset ( key, 0, sizeof ( *key ) );
+		if ( ( efirc = conin_ex->ReadKeyStrokeEx ( conin_ex,
+							   key ) ) == 0 )
+			return 1;
+	}
+	memset ( key, 0, sizeof ( *key ) );
+	if ( ( efirc = conin->ReadKeyStroke ( conin, &key->Key ) ) == 0 )
+		return 1;
+
+	return 0;
 }
 
