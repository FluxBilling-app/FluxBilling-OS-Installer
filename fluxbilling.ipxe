#!ipxe
# Boot menu for the FluxBilling OS installer, baked into the ISO image.
# Distro image + boot-image URLs live in the block below. Host, network and
# password get asked at runtime and ride out on the kernel command line.

set ctl:hex 1b
# FluxBilling console palette: two-tone mono + one brand-blue accent.
# ESC mechanism (ctl:hex 1b + ${ctl:string}) preserved untouched.
#   ink  = bold white : wordmark, field labels, the active question
#   meta = plain white: version, portal, hints, values - reads as gray
#   acc  = brand blue : the single restrained accent ('>' steps, '!' failures)
#   err  = bold white : the failure text itself - no red anywhere
#
# The accent is TWO sequences on purpose. Basic cyan 36 lands first, then the
# xterm 24-bit form carrying the exact fluxbilling.app blue #038BF8. iPXE's
# framebuffer console parses "38;2;<r>;<g>;<b>" (core/fbcon.c) and repaints
# with the real brand colour, which the 8-colour palette cannot express - its
# blue is #0000AA (near-black on this background) and its cyan a #00AAAA teal.
# Everything else - the BIOS and EFI text consoles, a 16-colour SOL terminal -
# ignores aspect 38 and every out-of-range parameter that follows it, so those
# fall back to the cyan already set. Keep 36 as the base for exactly that
# reason; 34 would be unreadable on black wherever the 24-bit form is dropped.
set b_on ${ctl:string}[1m
set b_off ${ctl:string}[22m
set rst ${ctl:string}[0m
set cl_wht ${ctl:string}[37m
set cl_blu ${ctl:string}[36m${ctl:string}[38;2;3;139;248m
set ink ${b_on}${cl_wht}
set meta ${cl_wht}
set acc ${cl_blu}
set err ${b_on}${cl_wht}

set app_name Flux Installer
set app_ver 1.1
set portal FluxBilling.app

# --- distro image + boot endpoints ---
#
# Scheme policy, deliberate and not uniform. Two different clients fetch from
# these hosts and they have very different trust stores:
#
#   iPXE (kernel + initrd) trusts ONLY the iPXE root CA - the default TRUSTED
#   list in crypto/rootcert.c is a single fingerprint. Any public certificate
#   therefore fails to chain, and iPXE completes it by pulling a cross-signed
#   cert from CROSSCERT, which defaults to http://ca.ipxe.org/auto - over PLAIN
#   HTTP, from a third party. So https on an iPXE fetch buys no verified
#   transport; it only adds a boot-time dependency on ca.ipxe.org being
#   reachable from the management network. iPXE fetches stay http:// below.
#   (22.04.5 is the exception: its images still come from a GitHub release,
#   which publishes https only. See the note by set boot2204.)
#
#   Since the TRUST= build change (see build.sh) the binary carries a small
#   set of public root CAs plus the FluxBilling CA, so the https fetches iPXE
#   DOES make - the 22.04.5 GitHub release, and any mirror that 301s http to
#   https - validate properly with NO ca.ipxe.org round-trip. http:// stays
#   the default for iPXE fetches to keep TLS out of
#   the boot path where it buys nothing, not because it is unverifiable.
#
#   The INSTALLERS - casper, anaconda, linuxrc, dracut - carry a full CA bundle
#   and validate properly. Everything they pull is https:// below, and that is
#   the bulk of the bytes: the Ubuntu ISO, the ~800 MB anaconda stage2, the
#   Leap live squashfs, the package repos.
#
# Hence the distro vars below are stored SCHEME-LESS and the scheme is written
# at each use site. Keep it that way when adding a distro.
#
# Ubuntu casper: ONE version string per release drives everything. Canonical
# publishes the netboot kernel/initrd under the SAME releases.ubuntu.com
# directory as the ISO, so deriving both from ${rel*} makes kernel/ISO skew
# structurally impossible - there is no second pin to keep in sync any more.
# Bumping a point release is now a single edit here.
#
# 22.04.5 is the exception: it predates the netboot/ directory, which 404s for
# that release (and for every /22.04/ variant). Its kernel/initrd have to be
# extracted from the official ISO instead - see src/sign-boot-images.sh - so
# until that release is published it is the last third-party pin in the tree.
set rel2204 22.04.5
set rel2404 24.04.4
set rel2604 26.04
set ubu_rel https://releases.ubuntu.com
# The ISO is fetched by casper inside the initrd, never by iPXE -> https.
set img2204 ${ubu_rel}/${rel2204}/ubuntu-${rel2204}-live-server-amd64.iso
set img2404 ${ubu_rel}/${rel2404}/ubuntu-${rel2404}-live-server-amd64.iso
set img2604 ${ubu_rel}/${rel2604}/ubuntu-${rel2604}-live-server-amd64.iso
# Kernel + initrd, fetched by iPXE. Official Canonical netboot images, from
# the same compose as the ISO above. http:// deliberately - see the policy
# note: iPXE cannot verify TLS without leaning on ca.ipxe.org over plain HTTP.
set boot2404 http://releases.ubuntu.com/${rel2404}/netboot/amd64
set boot2604 http://releases.ubuntu.com/${rel2604}/netboot/amd64
# TODO: replace with the extracted-and-signed 22.04.5 casper images once the
# first boot-* release is cut; this is the only non-official source left.
set boot2204 https://github.com/netbootxyz/ubuntu-squash/releases/download/22.04.5-be230164
# d-i hosts, one var per Debian suite: the same host serves both the iPXE
# netboot fetch AND the apt mirror d-i is preseeded with. http on purpose -
# apt verifies every package against the distro GPG keys regardless of
# transport, and mirror/protocol=https is not dependable across the 18.04 /
# Debian 11 installers we still boot. Per-suite because an archived suite
# moves to a DIFFERENT host on its own schedule: Debian DELETES it from
# deb.debian.org (buster already 404s) and it survives only on
# archive.debian.org. :di_fallback retries the archive host automatically at
# boot; flipping a var here makes it permanent in the next build.
set deb13_host deb.debian.org
set deb12_host deb.debian.org
set deb11_host deb.debian.org
# Scheme-less: http:// for the iPXE kernel/initrd fetch, https:// for whatever
# the installer pulls. See the policy note above.
set alma_url repo.almalinux.org/almalinux
set rocky_url download.rockylinux.org/pub/rocky
set centos_url mirror.stream.centos.org
set leap156_url download.opensuse.org/distribution/leap/15.6/repo/oss
set leap160_url download.opensuse.org/distribution/leap/16.0/repo/oss
# The Agama live image must NOT come from ${leap160_url}/LiveOS/squashfs.img:
# that arch-ambiguous path serves an s390x root filesystem (verified by
# unsquashfs - /bin/sh is an IBM S/390 ELF), so the x86_64 kernel mounts it
# and dies at switch_root with "Failed to execute /bin/sh: Exec format
# error". The per-arch installer ISO is the only published x86_64 live
# payload; dracut's livenet loop-mounts an ISO URL and finds the nested
# LiveOS/squashfs.img itself. Unversioned name = tracks the current build.
set leap160_live download.opensuse.org/distribution/leap/16.0/installer/iso/agama-installer.x86_64-Leap_16.0.iso
# Oracle Linux: yum.oracle.com serves the BaseOS/AppStream REPOS (plain
# repodata, which is all anaconda's dnf payload needs) but publishes NO
# expanded install tree - images/pxeboot/ and .treeinfo 404 there, and the
# boot artifacts exist officially only inside the boot ISO under
# yum.oracle.com/ISOS/. So the kernel, initrd AND the anaconda stage2
# (install.img) are extracted from that official boot ISO by
# src/sign-boot-images.sh and published on this repo's boot-* release - the
# same mechanism that replaces the 22.04 netbootxyz pin. These entries fail
# at :boot_fail until that release is cut; the watchdog probes the URLs and
# stays red for exactly as long as that is true.
#
# The stage2 base is a tag-with-a-slash on purpose: dracut appends
# /images/install.img to inst.stage2=<base> (no .treeinfo -> default path,
# see anaconda's anaconda-lib.sh), and GitHub routes
# /releases/download/<tag>/<asset> with the slash INSIDE the tag - so tag
# "<flux_rel>-olN/images" + asset "install.img" serves exactly the path
# anaconda asks for, from a host whose flat release URLs could not otherwise
# express it. Verify the URL once after cutting a release; if GitHub ever
# refuses slash tags, any static host that can serve <base>/images/install.img
# can replace the base here.
#
# github.com is https-only; both fetchers validate it: iPXE against the
# TRUST= roots baked in build.sh (the 22.04 GitHub release already relies on
# this), anaconda with its full CA bundle.
set flux_boot https://github.com/FluxBilling-app/FluxBilling-OS-Installer/releases/download
set flux_rel boot-20260815
set ol_repo yum.oracle.com/repo/OracleLinux
# Proxmox VE: no netboot images exist upstream, so kernel + initrd come from
# the boot-* release (extracted from the official ISO, see
# sign-boot-images.sh) and the UNMODIFIED official ISO itself is fetched by
# iPXE and injected into the initramfs as /proxmox.iso, which the stock
# installer init loop-mounts as its install media (the documented
# pve-iso-2-pxe mechanism, built into the installer since PVE 6). http:// on
# purpose, and not only for the usual iPXE-TLS reason: download.proxmox.com's
# certificate is issued for the cdn.proxmox.com pool and does NOT carry
# download.proxmox.com in its SANs (verified 2026-07), so an https fetch
# fails hostname validation outright. The release stages a detached signature
# for the ISO (proxmox-N-iso.sig), so the future imgverify wiring in
# docs/SIGNED-BOOT.md can pin its content over plain http like every other
# boot image. (enterprise.proxmox.com serves the same /iso/ over VALID https
# today and sign-boot-images.sh fetches from there for exactly that reason;
# the menu stays on the canonical public download host rather than leaning on
# the subscription CDN staying anonymous-friendly.)
set pve_host download.proxmox.com
set pve9_iso proxmox-ve_9.2-1.iso
set pve8_iso proxmox-ve_8.4-1.iso
# Agama reads its profile straight out of the injected initrd file - Agama's
# URL handling supports the file scheme, so no host has to serve it (the old
# http://isodisk.atwebpages.com/... copy 404s, and an unreachable profile stops
# the install dead). Point this at an http(s) URL only if you want a profile
# that is edited without rebuilding the image.
set agama_url file:///run/flux-agama.json
set ns1 8.8.8.8
set ns2 1.1.1.1

console --x 800 --y 600 --picture logo.png ||

# Stamp each bundled helper file with its cpio path exactly once - they get
# appended to every Linux boot and simply go unread where they don't apply.
# This must be imgargs, never initrd: EMBED already loaded these images, so
# `initrd <name>` would try to DOWNLOAD the bare name, die with "Operation not
# supported" (no scheme, no base URI) before the cpio name is ever set, then
# splice the file verbatim ahead of the real compressed initrd -> "Initramfs
# unpacking failed: invalid magic" -> kernel panic. imgargs instead writes the
# cmdline (= the cpio path) onto the in-memory image, so iPXE cpio-wraps it the
# right way.
imgargs preseed.cfg flux-preseed.cfg ||
imgargs 99fluxseed scripts/casper-bottom/99fluxseed mode=755 mkdir=-1 ||
imgargs param.conf conf/param.conf mkdir=-1 ||
imgargs ks.cfg flux-ks.cfg ||
imgargs autoinst.xml flux-autoinst.xml ||
# First-boot credential scrub, copied into the target by preseed/late_command.
# d-i is the one family that cannot do this from its answer file: the password
# arrives as passwd/root-password= on the command line and lands in
# /var/log/installer, which d-i copies onto the target after late_command has
# already run. The other families do the same work inline from their own
# answer files, so this rides along unread there.
imgargs flux-scrub flux-scrub ||
imgargs flux-scrub.service flux-scrub.service ||
# Agama is the one family whose installer runs AFTER switch_root, so a profile
# at the initrd root is gone by the time inst.auto is read - and /run there is
# a tmpfs mount that would shadow an injected file anyway. So the profile goes
# in at the root and a dracut pre-pivot hook copies it into the LIVE /run,
# which systemd moves across the pivot (Agama's own hooks pass state the same
# way). inst.auto then reads file:///run/flux-agama.json.
imgargs agama-leap16.json flux-agama.json ||
imgargs 50-flux-agama.sh var/lib/dracut/hooks/pre-pivot/50-flux-agama.sh mode=755 mkdir=-1 ||
# Proxmox automated-install hook. The one family whose installer offers no
# answer-file argument at all on a stock ISO: unconfigured.sh only runs
# proxmox-fetch-answer when /cdrom/auto-installer-mode.toml exists, a file
# only `proxmox-auto-install-assistant prepare-iso` can put INSIDE the ISO.
# When it is absent, the stock fallback is an interactive debug shell -
# which is bash, and interactive bash sources /etc/bash.bashrc. This file IS
# that manual step, automated: it generates /run/automatic-installer-answers
# from the kernel command line and exits the shell, and unconfigured.sh feeds
# that file to proxmox-auto-installer regardless of how it appeared. cpio
# ordering makes the override safe: iPXE appends these entries after the
# vendor initrd, and later initramfs entries replace earlier ones. Inert
# everywhere else - it acts only when fluxpveauto=1 (set by :os_pick in
# automated mode for the pve entries only) AND the proxmox-auto-installer
# binary are both present; other families' initrds either never source it
# (busybox sh in d-i/casper) or fail the guards (dracut emergency shells).
imgargs pve-bashrc etc/bash.bashrc mkdir=-1 ||
# logo.png is deliberately NOT stamped here. It is true that iPXE splices every
# still-registered image into the initrd chain (image/initrd.c skips only
# IMAGE_HIDDEN), so a raw PNG left registered would land at the head of the
# chain -> "Initramfs unpacking failed: invalid magic" -> "Cannot open root
# device" panic on EVERY entry. But `console --picture` already removes it:
# console_exec() ends in "if ( image && ( ! opts.keep ) ) unregister_image()",
# and the console line above passes no --keep. By the time this block runs the
# image is gone, so an `imgargs logo.png` finds nothing, falls through to a
# download of a bare scheme-less name, and prints "Could not start download:
# Operation not supported" across the top of the branded boot screen - which is
# exactly what src/qemu-test.sh asserts must never appear. Add --keep to the
# console line and this line becomes mandatory again; the two go together.
#
# The flux-* prefixes above are deliberate. d-i will AUTO-LOAD /preseed.cfg from
# the initrd root, and YaST sniffs for /autoinst.xml on the media, both with no
# boot arg at all - so a plainly-named file would silently switch autoinstall
# (disk wipe included) back on during a MANUAL install. Under the flux-* names
# nothing touches them unless the automated-mode args further down say so.

:banner
echo
echo
echo   ${ink}${app_name} v${app_ver}${rst}   ${meta}Powered by ${portal}${rst}
echo   ${meta}------------------------------------------------------------${rst}
echo
echo   ${meta}The hosting platform that bills, provisions, and tracks the rack.${rst}
echo   ${meta}Automated billing and DCIM. Built like a native app.${rst}
echo

:net_pick
echo
echo   ${acc}>${rst} ${ink}Step 1 of 4   Network${rst}
echo   ${meta}------------------------------------------------------------${rst}
echo
set idx:int32 0
:net_row
isset ${net${idx}/mac} || goto net_row_end
echo      ${acc}[${idx}]${rst}  ${ink}net${idx}${rst}   ${meta}MAC ${net${idx}/mac}${rst}
inc idx
goto net_row
:net_row_end
echo
echo   ${meta}Pick the port whose cable is connected to your network.${rst}
echo
echo -n   ${ink}Port number${rst} ${meta}[ENTER = 0]:${rst} ${} && read nic
isset ${nic} || set nic 0
ifclose
ifopen net${nic} || goto net_bad
isset ${editing} && goto commit ||
goto ask_ip

:net_bad
echo   ${acc}!${rst} ${err}Interface net${nic} not found.${rst}
clear nic
goto net_pick

:ask_ip
echo
echo   ${acc}>${rst} ${ink}Step 2 of 4   Address${rst}
echo   ${meta}------------------------------------------------------------${rst}
echo
echo -n   ${ink}IP / subnet${rst} ${meta}(e.g. 203.0.113.111/27):${rst} ${} && read cidr_in
isset ${cidr_in} || goto ask_ip
fluxcidr ${cidr_in} || goto ip_bad
set ip ${fluxip}
set nm ${fluxmask}
set plen ${fluxprefix}
# Returning to the review screen after an IP edit is only safe when the
# gateway still belongs to the new address's subnet. gw_auto records the
# gateway fluxcidr derived at the moment gwip was last confirmed, so:
#   same derived gateway -> same subnet -> keep gwip (which may be a custom
#     one the operator typed) and go straight back to review;
#   different -> the corrected address moved subnet, so ask again with the
#     new default, or :commit would write a gateway unreachable from it.
isset ${editing} || goto ask_gw
iseq ${fluxgw} ${gw_auto} && goto commit ||
goto ask_gw

:ip_bad
echo
echo   ${acc}!${rst} ${err}Use IP/prefix format, e.g. 203.0.113.111/27 (prefix 1-31).${rst}
clear cidr_in
goto ask_ip

:ask_gw
echo
echo -n   ${ink}Gateway${rst} ${meta}[ENTER = ${fluxgw}]:${rst} ${} && read gwip
isset ${gwip} || set gwip ${fluxgw}
# Remember which subnet this gateway was chosen for - see :ask_ip.
set gw_auto ${fluxgw}
isset ${editing} && goto commit ||
goto ask_host

:ask_host
echo
echo   ${acc}>${rst} ${ink}Step 3 of 4   Hostname${rst}
echo
echo -n   ${ink}Hostname${rst}${meta}:${rst} ${} && read hostnm
isset ${hostnm} || goto ask_host
isset ${editing} && goto commit ||
goto ask_pw

:ask_pw
clear pw
form Step 4 of 4 - Root password for ${hostnm}
item --secret pw  Set the root password for the installed OS
present || goto ask_pw
isset ${pw} || goto ask_pw
set rootpw ${pw}
clear pw

:commit
clear editing
set net${nic}/ip ${ip}
set net${nic}/netmask ${nm}
set net${nic}/gateway ${gwip}
set net${nic}/dns ${ns1}
set macid 01-${netX/mac:hexhyp}
set net_kargs ip=${ip}::${gwip}:${nm}:${hostnm}::none:${ns1}:${ns2} BOOTIF=${macid} hostname=${hostnm}
set flux_kargs fluxhost=${hostnm} fluxpass=${rootpw} fluxcidr=${plen}
# On Dell iDRAC virtual consoles the mgag200 KMS driver spins up a
# drm_fb_helper worker that locks the framebuffer roughly 2.8s into early boot.
# nomodeset on its own won't stop casper's initramfs from binding it, so the
# module is hard-blacklisted as well and efifb/GOP drives the console instead.
# Whichever console= comes LAST wins /dev/console (= where installer UIs draw),
# so :os_pick appends ${con_kargs} to match the mode: automated lists ttyS0
# last so it's watchable over SOL, manual lists tty0 last so the UI lands on
# the iDRAC/video console.
set vga_kargs nomodeset modprobe.blacklist=mgag200
# Static-network preseed for d-i, fed in under BOTH modes - the values are
# already keyed in by hand; manual mode just keeps prompting for the rest.
set di_net net.ifnames=0 biosdevname=0 netcfg/choose_interface=auto netcfg/disable_dhcp=true netcfg/get_ipaddress=${ip} netcfg/get_netmask=${nm} netcfg/get_gateway=${gwip} netcfg/get_nameservers=${ns1} netcfg/confirm_static=true netcfg/get_hostname=${hostnm} netcfg/hostname=${hostnm}
# d-i credentials - wired up for autoinstall only.
#
# The user IDENTITY (fullname + username) must ride the cmdline too, NOT just
# the preseed file. On Debian netboot d-i the file (/flux-preseed.cfg) is
# applied before user-setup runs, so passwd/user-fullname + passwd/username
# from the file are enough. On the Ubuntu 18.04/20.04 legacy netboot build,
# user-setup runs BEFORE the file preseed lands: the cmdline password is
# known but the file-only fullname is not, so d-i stops at a critical
# "Full name for the new user" prompt and a zero-touch install hangs there
# forever. Cmdline preseeds are read first on every build (that is why the
# passwords never hung), so the identity goes here as well. Spaceless
# fullname: d-i splits the kernel cmdline on whitespace, so "Default User"
# would break - the GECOS field is cosmetic, "Flux" is fine.
set di_pass passwd/root-password=${rootpw} passwd/root-password-again=${rootpw} passwd/user-password=${rootpw} passwd/user-password-again=${rootpw} passwd/user-fullname=Flux passwd/username=user passwd/root-login=true

:review
menu Review your setup - fix anything before you continue
item go_os Continue to OS selection
item --gap
item fix_if Interface ........ net${nic}
item fix_ip IP / subnet ...... ${ip}/${plen}
item fix_gw Gateway .......... ${gwip}
item fix_host Hostname ......... ${hostnm}
item fix_pw Password ......... hidden (re-enter to change)
choose csel || goto review
goto ${csel}

:fix_if
set editing 1
clear nic
goto net_pick

:fix_ip
set editing 1
clear cidr_in
goto ask_ip

:fix_gw
set editing 1
clear gwip
goto ask_gw

:fix_host
set editing 1
clear hostnm
goto ask_host

:fix_pw
set editing 1
goto ask_pw

:go_os
goto os_pick

# ---- OS menu. ${amode} flips between AUTOMATED and MANUAL: automated
# populates the per-family answer-file args just below, manual wipes them - so
# each entry pulls and boots the identical installer, only interactively.
:os_pick
isset ${amode} || set amode auto
iseq ${amode} manual && goto kargs_manual ||
set mode_lbl AUTOMATED
set mode_seg [ Automated ] Manual
set con_kargs console=tty0 console=ttyS0,115200n8
set ubu_auto autoinstall ds=nocloud ${flux_kargs}
# locale/keyboard ride the CMDLINE, not only the preseed file: Ubuntu's
# bionic/focal d-i asks "Select a language" BEFORE it reads preseed/file -
# proven with a boot whose initramfs verifiably contained the file - and a
# critical question with no answer stalls the automated install forever.
# Kernel-cmdline preseeds are loaded at init, ahead of every question, on
# every d-i vintage. Harmless duplication for Debian, which reads the file
# in time.
set di_auto auto=true priority=critical preseed/file=/flux-preseed.cfg locale=en_US keyboard-configuration/layoutcode=us console-setup/ask_detect=false ${di_pass}
# The flux-hosted Ubuntu entries get their own variant WITHOUT preseed/file=:
# their -auto-initrd carries the preseed at the auto-load name /preseed.cfg,
# so the flux-preseed.cfg path does not exist there - and a dangling
# preseed/file= is not harmless: it resurfaces in the FINISH stage, where
# the failing re-load desyncs cdebconf and the install wedges in a corrupted
# main menu (matrix-observed on both 18.04 and 20.04).
set di_auto_flux auto=true priority=critical locale=en_US keyboard-configuration/layoutcode=us console-setup/ask_detect=false ${di_pass}
set ks_auto inst.ks=file:///flux-ks.cfg ${flux_kargs}
set ay_auto autoyast=file:///flux-autoinst.xml ${flux_kargs}
# inst.install takes a VALUE in Agama (=0 stops after reading the profile so a
# human can review it); the bare flag was relying on how a valueless option
# happens to parse. Spell the intent out.
set ag_auto inst.auto=${agama_url} inst.install=1 inst.finish=reboot ${flux_kargs}
# proxmox-start-auto-installer is the stock trigger (parse_cmdline in
# unconfigured.sh); fluxpveauto=1 arms the injected bashrc hook that
# generates the answers the stock trigger then consumes - see the imgargs
# note above. ${flux_kargs} rides along for the generator to read.
set pv_auto proxmox-start-auto-installer fluxpveauto=1 ${flux_kargs}
# live.password is the Agama live-env web-UI login. Automated installs never
# need it - the profile sets the real credentials - and it is the one
# cmdline credential no scrub used to reach, so it rides in MANUAL mode only,
# where the operator logs into https://<ip> with it.
clear ag_live
goto kargs_done

:kargs_manual
set mode_lbl MANUAL
set mode_seg Automated [ Manual ]
set con_kargs console=ttyS0,115200n8 console=tty0
clear ubu_auto
clear di_auto
clear di_auto_flux
clear ks_auto
clear ay_auto
clear ag_auto
clear pv_auto
set ag_live live.password=${rootpw}

:kargs_done
menu ${app_name} v${app_ver}   ${hostnm}   ${ip}/${plen} gw ${gwip}   ${mode_lbl}
item toggle_mode Install mode: ${mode_seg}
item ubu2604 Ubuntu 26.04 LTS
item ubu2404 Ubuntu 24.04 LTS
item ubu2204 Ubuntu 22.04 LTS
item ubu2004 Ubuntu 20.04 LTS
item ubu1804 Ubuntu 18.04 LTS
item deb13 Debian 13
item deb12 Debian 12
item deb11 Debian 11
item al10 AlmaLinux 10
item al9 AlmaLinux 9
item al8 AlmaLinux 8
item rk10 Rocky Linux 10
item rk9 Rocky Linux 9
item rk8 Rocky Linux 8
item cs10 CentOS Stream 10
item cs9 CentOS Stream 9
item ol10 Oracle Linux 10
item ol9 Oracle Linux 9
item ol8 Oracle Linux 8
item leap160 openSUSE Leap 16.0
item leap156 openSUSE Leap 15.6
item pve9 Proxmox VE 9
item pve8 Proxmox VE 8
item settings Back to settings
choose --default ubu2604 pick || goto os_pick
goto ${pick}

:toggle_mode
iseq ${amode} manual && set amode auto || set amode manual
goto os_pick

# ---- Ubuntu 22.04 and up (casper/subiquity): install ISO streams into RAM ----
# Canonical names the netboot kernel "linux"; the netbootxyz build 22.04.5
# still rides on calls it "vmlinuz". The initrd is "initrd" in both, so only
# the kernel needs a per-release name.
:ubu2604
set rtag 2604
set kname linux
goto boot_casper

:ubu2404
set rtag 2404
set kname linux
goto boot_casper

:ubu2204
set rtag 2204
set kname vmlinuz
goto boot_casper

:boot_casper
clear casper_retry
set kbase ${boot${rtag}}
set kurl ${img${rtag}}
:casper_try
kernel --name kboot ${kbase}/${kname} initrd=initrd.magic ${net_kargs} url=${kurl} ${ubu_auto} ${vga_kargs} ${con_kargs} || goto casper_fallback
set iurl ${kbase}/initrd
goto launch

# casper self-heal: when a point release is superseded, its directory leaves
# releases.ubuntu.com and the content survives under
# old-releases.ubuntu.com/releases/<version>/ - kernel over plain http (no
# TLS in the iPXE path), ISO over https for casper, which carries a full CA
# bundle. One retry there, then :boot_fail; loop-safe because the flag is
# checked before it is set and cleared on every fresh :boot_casper entry.
# (2204 lands here too if its GitHub pin dies; 22.04 has no netboot tree on
# old-releases either, so that retry 404s into :boot_fail - same end state
# as before, one extra fetch.)
:casper_fallback
isset ${casper_retry} && goto boot_fail ||
set casper_retry 1
# Drop anything the failed fetch left registered before re-using the name.
imgfree kboot ||
set kbase http://old-releases.ubuntu.com/releases/${rel${rtag}}/netboot/amd64
set kurl https://old-releases.ubuntu.com/releases/${rel${rtag}}/ubuntu-${rel${rtag}}-live-server-amd64.iso
goto casper_try

# ---- Ubuntu 18/20 and Debian 11/12/13, via the d-i netboot images ----
# Every entry sets a primary host (di_host), two fallback hosts (di_alt, then
# di_alt2) and a path (di_path). :boot_di fetches from the current host and
# :di_fallback walks the alternates on failure. The SAME host is preseeded as
# the apt mirror, so a suite booted off a fallback installs from it too -
# kernel, initrd and packages can never come from mismatched trees.
#
# The two hops cover different failures. Hop 1 is a country mirror: identical
# signed content on separate infrastructure, for the case where the primary
# is simply unreachable (archive.ubuntu.com was timing out on nearly every
# plain-http request during an audit of this tree, while https to the same
# host and every other mirror answered). Hop 2 is the archive host, for after
# the suite goes EOL - old-releases.ubuntu.com/ubuntu/dists/ carries EOL
# suites in this exact layout; bionic and focal are not there yet only
# because they are still on ESM.
:ubu2004
set dver 20.04
set di_host archive.ubuntu.com
set mir_dir /ubuntu
goto boot_di_flux

:ubu1804
set dver 18.04
set di_host archive.ubuntu.com
set mir_dir /ubuntu
goto boot_di_flux

# Debian is the ONE family that hard-breaks on its own schedule: once a suite
# is archived it is DELETED from deb.debian.org (buster already 404s there)
# and only survives on archive.debian.org, a different host. Nothing can
# PROBE for that from here - iPXE cannot test a URL without downloading it -
# but :di_fallback turns the resulting fetch failure into one automatic retry
# against the archive host, so an archived suite keeps installing from ISOs
# already in the field. Make it permanent (and skip the failed first fetch)
# in the next build by flipping the suite's deb*_host var at the top.
# Alma/Rocky/CentOS/Leap paths roll forward in place; Ubuntu casper has its
# own :casper_fallback.
:deb13
set suite trixie
set di_host ${deb13_host}
goto deb_di

:deb12
set suite bookworm
set di_host ${deb12_host}
goto deb_di

:deb11
set suite bullseye
set di_host ${deb11_host}
goto deb_di

:deb_di
clear di_hop1
clear di_hop2
# Debian has only one alternate - a suite is either live on deb.debian.org or
# archived on archive.debian.org (verified: buster's netboot images are 404
# on the former and served on the latter). di_alt2 repeats it so the second
# hop's equality test ends the walk instead of retrying the same host.
set di_alt archive.debian.org
set di_alt2 archive.debian.org
set di_path /debian/dists/${suite}/main/installer-amd64/current/images/netboot/debian-installer/amd64
set mir_dir /debian
goto boot_di

# Ubuntu 18.04/20.04 boot their d-i from this repo's boot-* release, NOT from
# archive.ubuntu.com like the Debian entries below. The released initrd
# carries /flux-preseed.cfg and /flux-scrub PREPENDED as an uncompressed cpio
# member (sign-boot-images.sh does the prepend). Reason: iPXE's magic initrd
# appends the embedded files AFTER the fetched vendor initrd.gz, and the
# 4.15/5.4 kernels these two entries boot stop unpacking at the first gzip
# member - "Initramfs unpacking failed: junk in compressed archive", verified
# empirically in both orders - so everything appended after the vendor image
# is silently discarded. d-i then answers every cmdline-preseeded question
# and stalls at "Select a language", the first question that lives only in
# the file. Prepending inside the released asset is the one layout an old
# kernel is guaranteed to unpack. Debian's 5.10+/6.x kernels unpack the
# appended member fine, so those entries keep the plain mirror path and its
# host-walk fallback. The apt mirror karg still points at di_host - only the
# boot images move; a flux_boot fetch failure is a boot_fail, same as ol*.
:boot_di_flux
# Two initrd assets per release, picked by mode. The -auto-initrd carries the
# preseed at /preseed.cfg - the name this d-i vintage AUTO-LOADS (it never
# reads preseed/file= at all; proven by a boot whose initramfs verifiably
# carried the file under the flux name and still stalled at partitioning).
# Auto-loading is also why the file must NOT be in the initrd that manual
# mode boots: it would re-arm automated partitioning on a manual install.
set di_img ubuntu-${dver}-initrd
isset ${di_auto} && set di_img ubuntu-${dver}-auto-initrd ||
kernel --name kboot ${flux_boot}/${flux_rel}/ubuntu-${dver}-vmlinuz initrd=initrd.magic ${di_net} mirror/country=manual mirror/http/hostname=${di_host} mirror/http/directory=${mir_dir} mirror/http/proxy= ${di_auto_flux} ${vga_kargs} ${con_kargs} || goto boot_fail
set iurl ${flux_boot}/${flux_rel}/${di_img}
goto launch

:boot_di
kernel --name kboot http://${di_host}${di_path}/linux initrd=initrd.magic ${di_net} mirror/country=manual mirror/http/hostname=${di_host} mirror/http/directory=${mir_dir} mirror/http/proxy= ${di_auto} ${vga_kargs} ${con_kargs} || goto di_fallback
set iurl http://${di_host}${di_path}/initrd.gz
goto launch

# d-i self-heal: walk di_alt, then di_alt2, then give up. The hop flags are
# cleared at the top of every entry block, so a failed attempt cannot poison
# the next one, and the iseq guards stop a host being retried against itself.
:di_fallback
isset ${di_hop2} && goto boot_fail ||
imgfree kboot ||
isset ${di_hop1} && goto di_hop_two ||
set di_hop1 1
iseq ${di_host} ${di_alt} && goto di_hop_two ||
set di_host ${di_alt}
goto boot_di

:di_hop_two
set di_hop2 1
iseq ${di_host} ${di_alt2} && goto boot_fail ||
set di_host ${di_alt2}
goto boot_di

# ---- AlmaLinux / Rocky Linux / CentOS Stream, using anaconda + kickstart ----
# The ~800 MB stage2 is pulled from inst.repo straight into RAM, so plan on
# 3 GB or more. The whole 10-series (Alma, Rocky, CentOS Stream) demands an
# x86_64-v3 CPU, i.e. Haswell or newer.
:al10
set ks_base ${alma_url}/10
goto boot_ks

:al9
set ks_base ${alma_url}/9
goto boot_ks

:al8
set ks_base ${alma_url}/8
goto boot_ks

:rk10
set ks_base ${rocky_url}/10
goto boot_ks

:rk9
set ks_base ${rocky_url}/9
goto boot_ks

:rk8
set ks_base ${rocky_url}/8
goto boot_ks

:cs10
set ks_base ${centos_url}/10-stream
goto boot_ks_https

:cs9
set ks_base ${centos_url}/9-stream
goto boot_ks_https

# mirror.stream.centos.org 301s every plain-http request to https, so the
# CentOS entries were already doing TLS - just via a redirect, invisibly, and
# formerly via ca.ipxe.org. Ask for https up front now that CERT=/TRUST= let
# iPXE validate it offline: one fewer round-trip at boot, and the watchdog
# sees a clean 200 instead of a redirect it must special-case. Alma and Rocky
# serve plain http in place, so they stay http.
:boot_ks_https
set ks_sch https
goto boot_ks_go

:boot_ks
set ks_sch http

:boot_ks_go
# ks_base is scheme-less. iPXE pulls vmlinuz/initrd over ${ks_sch}; anaconda
# pulls stage2 + every package over https, and ks.cfg builds the AppStream
# baseurl from fluxrepo, so that one needs the scheme spelled out too.
kernel --name kboot ${ks_sch}://${ks_base}/BaseOS/x86_64/os/images/pxeboot/vmlinuz initrd=initrd.magic ${net_kargs} inst.repo=https://${ks_base}/BaseOS/x86_64/os/ fluxrepo=https://${ks_base} inst.text ${ks_auto} ${vga_kargs} ${con_kargs} || goto boot_fail
set iurl ${ks_sch}://${ks_base}/BaseOS/x86_64/os/images/pxeboot/initrd.img
goto launch

# ---- Oracle Linux - anaconda + kickstart, boot images from the flux release ----
# The same kickstart flow as Alma/Rocky/CentOS with two Oracle-shaped
# differences, both explained at the flux_boot/ol_repo block up top:
#   1. kernel/initrd/stage2 come from this repo's boot-* release, because
#      Oracle publishes no install tree - inst.stage2 is passed explicitly
#      and inst.repo is the plain BaseOS yum repo (repodata only, which the
#      dnf payload is happy with).
#   2. yum.oracle.com spells AppStream "OL<v>/appstream/x86_64" - no
#      "/latest", no "/os" - so the ready-made baseurl rides in as fluxappst=
#      and ks.cfg prefers it over the fluxrepo-derived path. fluxrepo= is
#      deliberately NOT set here.
# OL10, like the rest of the 10-series, needs an x86_64-v3 CPU. Plan on the
# same 4 GB+ RAM as the other anaconda entries.
:ol10
set otag 10
goto boot_ol

:ol9
set otag 9
goto boot_ol

:ol8
set otag 8
goto boot_ol

:boot_ol
kernel --name kboot ${flux_boot}/${flux_rel}/oracle-${otag}-vmlinuz initrd=initrd.magic ${net_kargs} inst.stage2=${flux_boot}/${flux_rel}-ol${otag} inst.repo=https://${ol_repo}/OL${otag}/baseos/latest/x86_64/ fluxappst=https://${ol_repo}/OL${otag}/appstream/x86_64/ inst.text ${ks_auto} ${vga_kargs} ${con_kargs} || goto boot_fail
set iurl ${flux_boot}/${flux_rel}/oracle-${otag}-initrd
goto launch

# ---- openSUSE Leap 15.6 - linuxrc/YaST, AutoYaST read from the injected initrd file ----
:leap156
kernel --name kboot http://${leap156_url}/boot/x86_64/loader/linux initrd=initrd.magic install=https://${leap156_url} ifcfg=*=${ip}/${plen},${gwip},${ns1} hostname=${hostnm} textmode=1 ${ay_auto} ${vga_kargs} ${con_kargs} || goto boot_fail
set iurl http://${leap156_url}/boot/x86_64/loader/initrd
goto launch

# ---- openSUSE Leap 16.0 - the Agama live installer ----
# The ~400 MB live squashfs streams into RAM across the data NIC. Under
# autoinstall the agama profile is READ FROM THE IMAGE ITSELF: it is embedded
# as assets/agama-leap16.json, injected into the initrd, and the pre-pivot
# hook copies it to /run where inst.auto=${agama_url} picks it up - no host
# serves it. Manual mode drops you into interactive Agama: a web UI at
# https://<ip>, log in as root with the password typed into the menu
# (${ag_live} carries it in manual mode ONLY - see the note at :os_pick).
:leap160
kernel --name kboot http://${leap160_url}/boot/x86_64/loader/linux initrd=initrd.magic root=live:https://${leap160_live} rd.neednet=1 ${net_kargs} ${ag_live} ${ag_auto} ${vga_kargs} ${con_kargs} || goto boot_fail
set iurl http://${leap160_url}/boot/x86_64/loader/initrd
goto launch

# ---- Proxmox VE - the official installer, ISO streamed into the initramfs ----
# Three images instead of two: kernel + stock initrd from the boot-* release,
# then the ENTIRE official ISO (~1.7 GB) as a second initrd whose cpio name
# is proxmox.iso - the stock installer init loop-mounts exactly that path as
# its install media (see the pve_host note up top). Everything installs from
# the ISO in RAM, so plan on 6 GB+; no packages are fetched at install time.
# ramdisk_size/rw/quiet mirror the ISO's own boot entries. The installer
# environment DHCPs and simply times out in a static colo - harmless, the
# TARGET network config comes from the generated answers (automated) or the
# operator (manual). MANUAL mode is the stock GUI installer on the video
# console; automated is watchable over SOL like every other family.
:pve9
set ptag 9
set piso ${pve9_iso}
goto boot_pve

:pve8
set ptag 8
set piso ${pve8_iso}
goto boot_pve

:boot_pve
kernel --name kboot ${flux_boot}/${flux_rel}/proxmox-${ptag}-vmlinuz initrd=initrd.magic ramdisk_size=16777216 rw quiet ${pv_auto} ${net_kargs} ${vga_kargs} ${con_kargs} || goto boot_fail
initrd --name iboot ${flux_boot}/${flux_rel}/proxmox-${ptag}-initrd || goto boot_fail
set got_i 1
initrd --name pviso http://${pve_host}/iso/${piso} proxmox.iso || goto boot_fail
set got_p 1
boot || goto boot_fail

:settings
goto review

# Shared success tail for every Linux family: the kernel is already loaded, so
# pull the initrd named in ${iurl}, flag it (got_i) so :boot_fail knows an
# initrd image exists to free, and hand control to the kernel. There is no
# matching flag for the kernel: :boot_fail frees kboot unconditionally,
# because a fetch can leave an image registered even when the command failed.
:launch
initrd --name iboot ${iurl} || goto boot_fail
set got_i 1
boot || goto boot_fail

# Release whatever the failed attempt pulled down, so the next try starts
# clean. This is UNCONDITIONAL on purpose. `kernel --name kboot <url>`
# registers the image the moment the DOWNLOAD succeeds (usr/imgmgmt.c) and
# core/image.c deliberately ignores a failed type probe - so a fetch that
# returned a captive-portal page, a truncated file or an HTML error body
# leaves a registered `kboot` behind even though the command reported
# failure. iPXE then splices every still-registered image into the initrd
# chain of the NEXT boot: "Initramfs unpacking failed: invalid magic",
# followed by a root-device panic, on an entry that is itself fine.
# Gating on got_k missed exactly that case.
#
# iboot is DIFFERENT and keeps its flag: `initrd` only ever runs after the
# kernel loaded, and got_i is set immediately after it returns, so the flag
# provably tracks whether an initrd exists. Freeing it unconditionally would
# print a second "no such image" line above the branded failure banner on
# every kernel-stage failure - the trailing `||` swallows the exit status,
# not the message.
:boot_fail
imgfree kboot ||
isset ${got_i} && imgfree iboot ||
clear got_i
# The Proxmox entries load a third image; same flag discipline as iboot.
isset ${got_p} && imgfree pviso ||
clear got_p
echo
echo   ${acc}!${rst} ${err}Boot failed.${rst}${meta} Check settings, network, and mirror availability.${rst}
prompt Press any key to return to the menu...
goto os_pick
